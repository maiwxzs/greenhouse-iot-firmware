        <UserObject label="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;LecturaDato&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;+idLectura : uint16&lt;br&gt;+timestamp : unsigned long&lt;br&gt;+valor : float&lt;br&gt;+unidad : texto&lt;br&gt;+valida : bool&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;+esValida() bool&lt;br&gt;+formatearSalida(salida)&lt;/p&gt;" mermaidId="n:LecturaDato" id="mmd-6"><mxCell parent="mmd-2" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fillColor=#E8F3EC;strokeColor=#2E7A4C;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=12;fontColor=#1E2D24;" vertex="1"><mxGeometry x="35.4" y="1032.5" width="265.8" height="252.0" as="geometry"/></mxCell></UserObject>
