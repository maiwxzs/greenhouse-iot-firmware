<mxfile host="app.diagrams.net">
  <diagram name="uml-clases" id="uml-clases">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3373" pageHeight="1766" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n    class Invernadero {\n        +idInvernadero : texto\n        +nombre : texto\n        +sistemaActivo : bool\n        +asignarControlador(c)\n        +iniciarSistema()\n        +monitorear(ahora)\n    }\n    class ControladorArduino {\n        +puertoSerie : unsigned long\n        +frecuenciaMuestreo : unsigned long\n        +estadoActual : EstadoSistema\n        +inicializar()\n        +ciclo(ahora)\n        +leerSensores(ahora)\n        +ejecutarLogica(ahora)\n        +enviarTelemetria(ahora)\n        +enviarAjustes()\n    }\n    class ReglaControl {\n        +evaluarTemperatura(t)\n        +evaluarHumedad(h)\n        +evaluarHumedadSuelo(s, usada)\n        +evaluarNivelAgua(hayAgua, usada)\n        +requiereVentilacion() bool\n        +requiereRiego() bool\n        +hayAlarma() bool\n        +obtenerEstado() EstadoSistema\n    }\n    class LecturaDato {\n        +idLectura : uint16\n        +timestamp : unsigned long\n        +valor : float\n        +unidad : texto\n        +valida : bool\n        +esValida() bool\n        +formatearSalida(salida)\n    }\n    class Ajustes {\n        +tempMax, tempCritica : float\n        +humAireMin, humAireMax : float\n        +humSueloMin, humSueloMax : float\n        +calibraciones ADC : int16\n        +luzHoraInicio, luzHoraFin : uint8\n        +checksum : uint8\n    }\n    class AlmacenAjustes {\n        +deFabrica()$ Ajustes\n        +cargar(a)$ bool\n        +guardar(a)$\n    }\n    class Sensor {\n        &lt;&lt;abstract&gt;&gt;\n        +idPin : uint8\n        +nombre : texto\n        +activo : bool\n        +inicializar()*\n        +obtenerLectura(ahora)*\n        +ultimaLectura() LecturaDato\n    }\n    class SensorTemperatura {\n        +temperatura : float\n        +leerTemperatura(ahora)\n        +sensoresDetectados() uint8\n    }\n    class SensorHumedad {\n        +humedad : float\n        +superaUmbral : bool\n        +valorAdc : int\n        +leerHumedad(ahora)\n        +porcentajeHumedad() float\n    }\n    class SondaResistiva {\n        &lt;&lt;abstract&gt;&gt;\n        +valorAdc : int\n        +medirAdc() int\n    }\n    class SensorHumedadSuelo {\n        +humedad : float\n    }\n    class SensorNivelAgua {\n        +hayAgua : bool\n    }\n    class Actuador {\n        &lt;&lt;abstract&gt;&gt;\n        +idPin : uint8\n        +estado : bool\n        +inicializar()*\n        +encender()*\n        +apagar()*\n        +actualizar(ahora)\n    }\n    class IndicadorLED {\n        +color : texto\n        +parpadeo : bool\n        +cambiarEstado()\n        +parpadear(periodo, invertido)\n    }\n    class Zumbador {\n        +pasivo : bool\n        +pitar(veces, duracion)\n    }\n    class ActuadorRele {\n        +activoEnBajo : bool\n        +nombre : texto\n    }\n    class BombaAgua {\n        +solicitarPulso(ahora, forzado) bool\n        +segundosUsadosEnHora() unsigned long\n    }\n    class Ventilador\n    class LuzCultivo\n    class CicloTrabajoBomba {\n        +solicitarPulso(ahora, forzado) bool\n        +actualizar(ahora) bool\n        +msUsadosEnHora() unsigned long\n    }\n    class RelojSoftware {\n        +ajustar(h, m, s, ahora)\n        +segundosDelDia(ahora) unsigned long\n        +estaSincronizado() bool\n    }\n    class PantallaLCD {\n        +inicializar() bool\n        +mostrar(resumen, ahora)\n    }\n    class BotonPulsador {\n        +actualizar(ahora) EventoBoton\n    }\n    Invernadero \&quot;1\&quot; --&gt; \&quot;1\&quot; ControladorArduino : gestiona\n    ControladorArduino \&quot;1\&quot; o-- \&quot;4\&quot; Sensor : lee de\n    ControladorArduino \&quot;1\&quot; o-- \&quot;7\&quot; Actuador : controla\n    ControladorArduino --&gt; ReglaControl : evalúa con\n    ControladorArduino *-- RelojSoftware\n    ControladorArduino *-- PantallaLCD\n    ControladorArduino o-- BotonPulsador\n    ControladorArduino ..&gt; AlmacenAjustes : usa\n    AlmacenAjustes ..&gt; Ajustes : guarda\n    ReglaControl --&gt; Ajustes : consulta\n    ReglaControl ..&gt; LecturaDato : usa\n    Sensor ..&gt; LecturaDato : produce\n    Sensor &lt;|-- SensorTemperatura\n    Sensor &lt;|-- SensorHumedad\n    Sensor &lt;|-- SondaResistiva\n    SondaResistiva &lt;|-- SensorHumedadSuelo\n    SondaResistiva &lt;|-- SensorNivelAgua\n    Actuador &lt;|-- IndicadorLED\n    Actuador &lt;|-- Zumbador\n    Actuador &lt;|-- ActuadorRele\n    ActuadorRele &lt;|-- BombaAgua\n    ActuadorRele &lt;|-- Ventilador\n    ActuadorRele &lt;|-- LuzCultivo\n    BombaAgua *-- CicloTrabajoBomba\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mmd-2"><mxCell connectable="0" parent="1" vertex="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;"><mxGeometry x="20" y="20" width="3313.9" height="1706.0" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Invernadero&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;+idInvernadero : texto&lt;br&gt;+nombre : texto&lt;br&gt;+sistemaActivo : bool&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;+asignarControlador(c)&lt;br&gt;+iniciarSistema()&lt;br&gt;+monitorear(ahora)&lt;/p&gt;" mermaidId="n:Invernadero" id="mmd-3"><mxCell parent="mmd-2" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fillColor=#E8F3EC;strokeColor=#2E7A4C;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=12;fontColor=#1E2D24;" vertex="1"><mxGeometry x="2013.0" y="8.0" width="233.5" height="229.5" as="geometry"/></mxCell></UserObject>
