<mxfile host="app.diagrams.net">
  <diagram name="protocolo-mensajes" id="protocolo-mensajes">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1277" pageHeight="1324" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction LR\n    class Arduino {\n        +enviarTelemetria()\n        +enviarAjustes()\n        +ejecutarComando(linea)\n    }\n    class Aplicacion {\n        +interpretarLinea(linea)\n        +enviar(comando)\n    }\n    class Telemetria {\n        &lt;&lt;tipo tel, cada 2 s&gt;&gt;\n        +t_ms : entero\n        +hora : texto hh mm ss\n        +hora_sync : 0 o 1\n        +temp_c : número o null\n        +aire_alta : 0 o 1\n        +hum_suelo : número o null\n        +adc_suelo : entero\n        +agua : 0, 1 o null\n        +adc_agua : entero\n        +estado : Estado\n        +aire : Nivel\n        +suelo : Nivel\n        +ventilador, bomba : 0 o 1\n        +alarma : 0, 1 o 2\n        +bomba_s_hora : entero\n    }\n    class Configuracion {\n        &lt;&lt;tipo cfg&gt;&gt;\n        +version : texto\n        +temp_max, temp_hist, temp_crit : número\n        +suelo_min, suelo_max, hist : número\n        +adc_suelo_seco, adc_suelo_hum : entero\n        +umbral_agua : entero\n        +solo_arduino, sonda_suelo, sonda_agua, lcd : 0 o 1\n    }\n    class Respuesta {\n        &lt;&lt;tipo ok o error&gt;&gt;\n        +cmd : texto\n        +msg : texto\n    }\n    class Comando {\n        &lt;&lt;texto terminado en salto de línea&gt;&gt;\n        +TEMP, TEMPCRIT, TEMPHIST valor\n        +SUELOMIN, SUELOMAX, HIST valor\n        +HORA hh mm ss\n        +RIEGO, SILENCIO, ESTADO, FABRICA\n        +CAL SUELOSECO, SUELOHUMEDO o TANQUE\n        +UMBRALAGUA valor\n    }\n    class Estado {\n        &lt;&lt;enumeración&gt;&gt;\n        NORMAL\n        HUMEDAD_ALTA\n        SUELO_ENCHARCADO\n        SUELO_SECO\n        TEMPERATURA_ALTA\n        TEMPERATURA_CRITICA\n        SIN_AGUA\n        SIN_DATOS\n        FALLA_SENSOR_TEMP\n    }\n    class Nivel {\n        &lt;&lt;enumeración&gt;&gt;\n        BAJA\n        NORMAL\n        ALTA\n        DESCONOCIDA\n        NO_USADO\n    }\n    Arduino ..&gt; Telemetria : emite\n    Arduino ..&gt; Configuracion : emite\n    Arduino ..&gt; Respuesta : responde\n    Aplicacion ..&gt; Comando : envía\n    Arduino ..&gt; Comando : ejecuta\n    Telemetria --&gt; Estado\n    Telemetria --&gt; Nivel\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mmd-2"><mxCell connectable="0" parent="1" vertex="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;"><mxGeometry x="20" y="20" width="1217.5" height="1264.8" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Arduino&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;+enviarTelemetria()&lt;br&gt;+enviarAjustes()&lt;br&gt;+ejecutarComando(linea)&lt;/p&gt;" mermaidId="n:Arduino" id="mmd-3"><mxCell parent="mmd-2" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fillColor=#E8F3EC;strokeColor=#2E7A4C;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=12;fontColor=#1E2D24;" vertex="1"><mxGeometry x="8.0" y="209.9" width="233.7" height="168.0" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Aplicacion&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;+interpretarLinea(linea)&lt;br&gt;+enviar(comando)&lt;/p&gt;" mermaidId="n:Aplicacion" id="mmd-4"><mxCell parent="mmd-2" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fillColor=#E8F3EC;strokeColor=#2E7A4C;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=12;fontColor=#1E2D24;" vertex="1"><mxGeometry x="11.6" y="1100.0" width="230.1" height="145.5" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«tipo tel, cada 2 s»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Telemetria&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;+t_ms : entero&lt;br&gt;+hora : texto hh mm ss&lt;br&gt;+hora_sync : 0 o 1&lt;br&gt;+temp_c : número o null&lt;br&gt;+aire_alta : 0 o 1&lt;br&gt;+hum_suelo : número o null&lt;br&gt;+adc_suelo : entero&lt;br&gt;+agua : 0, 1 o null&lt;br&gt;+adc_agua : entero&lt;br&gt;+estado : Estado&lt;br&gt;+aire : Nivel&lt;br&gt;+suelo : Nivel&lt;br&gt;+ventilador, bomba : 0 o 1&lt;br&gt;+alarma : 0, 1 o 2&lt;br&gt;+bomba_s_hora : entero&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;&amp;nbsp;&lt;/p&gt;" mermaidId="n:Telemetria" id="mmd-5"><mxCell parent="mmd-2" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fillColor=#F3F7F5;strokeColor=#2E7A4C;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=12;fontColor=#1E2D24;" vertex="1"><mxGeometry x="561.8" y="16.2" width="286.2" height="454.5" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«tipo cfg»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Configuracion&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;+version : texto&lt;br&gt;+temp_max, temp_hist, temp_crit : número&lt;br&gt;+suelo_min, suelo_max, hist : número&lt;br&gt;+adc_suelo_seco, adc_suelo_hum : entero&lt;br&gt;+umbral_agua : entero&lt;br&gt;+solo_arduino, sonda_suelo, sonda_agua, lcd : 0 o 1&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;&amp;nbsp;&lt;/p&gt;" mermaidId="n:Configuracion" id="mmd-6"><mxCell parent="mmd-2" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fillColor=#F3F7F5;strokeColor=#2E7A4C;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=12;fontColor=#1E2D24;" vertex="1"><mxGeometry x="428.7" y="510.8" width="442.3" height="252.0" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«tipo ok o error»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Respuesta&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;+cmd : texto&lt;br&gt;+msg : texto&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;&amp;nbsp;&lt;/p&gt;" mermaidId="n:Respuesta" id="mmd-7"><mxCell parent="mmd-2" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fillColor=#F3F7F5;strokeColor=#2E7A4C;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=12;fontColor=#1E2D24;" vertex="1"><mxGeometry x="428.7" y="802.8" width="171.9" height="162.0" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«texto terminado en salto de línea»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Comando&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;+TEMP, TEMPCRIT, TEMPHIST valor&lt;br&gt;+SUELOMIN, SUELOMAX, HIST valor&lt;br&gt;+HORA hh mm ss&lt;br&gt;+RIEGO, SILENCIO, ESTADO, FABRICA&lt;br&gt;+CAL SUELOSECO, SUELOHUMEDO o TANQUE&lt;br&gt;+UMBRALAGUA valor&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;&amp;nbsp;&lt;/p&gt;" mermaidId="n:Comando" id="mmd-8"><mxCell parent="mmd-2" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fillColor=#F3F7F5;strokeColor=#2E7A4C;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=12;fontColor=#1E2D24;" vertex="1"><mxGeometry x="428.7" y="1004.8" width="485.8" height="252.0" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«enumeración»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Estado&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;NORMAL&lt;br&gt;HUMEDAD_ALTA&lt;br&gt;SUELO_ENCHARCADO&lt;br&gt;SUELO_SECO&lt;br&gt;TEMPERATURA_ALTA&lt;br&gt;TEMPERATURA_CRITICA&lt;br&gt;SIN_AGUA&lt;br&gt;SIN_DATOS&lt;br&gt;FALLA_SENSOR_TEMP&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;&amp;nbsp;&lt;/p&gt;" mermaidId="n:Estado" id="mmd-9"><mxCell parent="mmd-2" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fillColor=#F3F7F5;strokeColor=#2E7A4C;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=12;fontColor=#1E2D24;" vertex="1"><mxGeometry x="954.5" y="8.0" width="255.0" height="319.5" as="geometry"/></mxCell></UserObject>
