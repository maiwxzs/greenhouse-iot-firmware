        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    A([\&quot;Cada vuelta del loop\&quot;]) --&gt; B[\&quot;Atender pulsador y comandos serie\&quot;]\n    B --&gt; C[\&quot;Actualizar actuadores&lt;br/&gt;fin de pulso, parpadeos, pitidos\&quot;]\n    C --&gt; D{\&quot;¿Pasaron 2 s?\&quot;}\n    D --&gt;|No| A\n    D --&gt;|Sí| E[\&quot;Leer sensores&lt;br/&gt;temperatura, aire, suelo y tanque\&quot;]\n    E --&gt; F[\&quot;ReglaControl evalúa con histéresis\&quot;]\n    F --&gt; G{\&quot;¿Tanque vacío?\&quot;}\n    G --&gt;|Sí| H[\&quot;Bloquear la bomba&lt;br/&gt;LED rojo parpadea y alarma\&quot;]\n    G --&gt;|No| I{\&quot;¿Suelo seco, o aire seco&lt;br/&gt;sin suelo encharcado?\&quot;}\n    I --&gt;|Sí| J[\&quot;Pulso de riego de 5 s&lt;br/&gt;pausa 1 min, máximo 15 min/h\&quot;]\n    I --&gt;|No| K[\&quot;Bomba apagada\&quot;]\n    H --&gt; L{\&quot;¿Calor, aire húmedo&lt;br/&gt;o falla del sensor?\&quot;}\n    J --&gt; L\n    K --&gt; L\n    L --&gt;|Sí| M[\&quot;Pedir ventilador\&quot;]\n    L --&gt;|No| N[\&quot;Sin ventilación\&quot;]\n    M --&gt; O[\&quot;Luz según horario o modo\&quot;]\n    N --&gt; O\n    O --&gt; P[\&quot;Reparto de energía&lt;br/&gt;bomba, luego ventilador, luego luz\&quot;]\n    P --&gt; Q[\&quot;LEDs, alarma, telemetría JSON y LCD\&quot;]\n    Q --&gt; A\n    classDef decision fill:#FFF3E0,stroke:#B9790A,color:#1E2D24\n    classDef accion fill:#E8F3EC,stroke:#2E7A4C,color:#1E2D24\n    classDef alerta fill:#FBE9E7,stroke:#B3332E,color:#1E2D24\n    class D,G,I,L decision\n    class B,C,E,F,J,K,M,N,O,P,Q accion\n    class H alerta\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mmd-2"><mxCell connectable="0" parent="1" vertex="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;"><mxGeometry x="20" y="20" width="864.0" height="2312.2" as="geometry"/></mxCell></UserObject>
