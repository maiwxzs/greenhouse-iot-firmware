        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    ARD[\&quot;Arduino Uno&lt;br/&gt;USB serie\&quot;]\n    subgraph APLI[\&quot;Aplicación de escritorio Invernadero IoT (Electron, Windows)\&quot;]\n        direction LR\n        subgraph MAIN[\&quot;Proceso principal, electron/\&quot;]\n            direction TB\n            VEN[\&quot;main.cjs&lt;br/&gt;ventana y permisos\&quot;]\n            PUE[\&quot;Elección del puerto&lt;br/&gt;select-serial-port\&quot;]\n        end\n        subgraph HOOKS[\&quot;Conexión\&quot;]\n            direction TB\n            CON[\&quot;useConexion&lt;br/&gt;Web Serial, 9600 baudios\&quot;]\n            SIM[\&quot;Simulador&lt;br/&gt;demostración\&quot;]\n        end\n        subgraph LIB[\&quot;Datos, src/lib\&quot;]\n            direction TB\n            PROT[\&quot;protocolo.js&lt;br/&gt;interpreta cada línea\&quot;]\n            REG[\&quot;registro.js&lt;br/&gt;eventos, minutos, estadísticas\&quot;]\n            ALM[\&quot;almacen.js\&quot;]\n        end\n        subgraph IDB[\&quot;IndexedDB, en el equipo\&quot;]\n            direction TB\n            LEC[(\&quot;lecturas&lt;br/&gt;2 días\&quot;)]\n            MIN[(\&quot;minutos&lt;br/&gt;180 días\&quot;)]\n            EVT[(\&quot;eventos&lt;br/&gt;180 días\&quot;)]\n        end\n        subgraph UI[\&quot;Interfaz React\&quot;]\n            direction TB\n            APPC[\&quot;App\&quot;]\n            ESC[\&quot;Maqueta interactiva&lt;br/&gt;escena/\&quot;]\n            TAB[\&quot;Tablero y réplica LCD\&quot;]\n            SEC[\&quot;Gráficas, Historial, Eventos,&lt;br/&gt;Ajustes, Calibración, Consola\&quot;]\n            SEL[\&quot;SelectorPuerto\&quot;]\n        end\n    end\n    ARD &lt;--&gt;|\&quot;líneas JSON y comandos\&quot;| CON\n    PUE --&gt;|\&quot;lista de puertos\&quot;| SEL\n    SEL --&gt;|\&quot;puerto elegido\&quot;| PUE\n    PUE -.-&gt;|\&quot;permiso\&quot;| CON\n    SIM -.-&gt;|\&quot;mismo protocolo\&quot;| PROT\n    CON --&gt; PROT\n    PROT --&gt; APPC\n    APPC --&gt; REG\n    REG --&gt; ALM\n    ALM --&gt; LEC\n    ALM --&gt; MIN\n    ALM --&gt; EVT\n    APPC --&gt; ESC\n    APPC --&gt; TAB\n    APPC --&gt; SEC\n    SEC --&gt;|\&quot;consulta el historial\&quot;| ALM\n    VEN -.-&gt; APPC\n    class ARD control\n    class CON,SIM,VEN,PUE interfaz\n    class PROT,REG,ALM app\n    class LEC,MIN,EVT dato\n    class APPC,ESC,TAB,SEC,SEL actuador\n\n    classDef sensor fill:#E3F0FA,stroke:#2370AE,color:#16324A,stroke-width:1.5px\n    classDef actuador fill:#FFF1DC,stroke:#B9790A,color:#4A3305,stroke-width:1.5px\n    classDef control fill:#E3F2E8,stroke:#2E7A4C,color:#173B26,stroke-width:1.5px\n    classDef interfaz fill:#F2E8F7,stroke:#7B3FA0,color:#3A1F4C,stroke-width:1.5px\n    classDef dato fill:#EEF1F4,stroke:#546E7A,color:#263238,stroke-width:1.5px\n    classDef app fill:#E0F2EF,stroke:#00796B,color:#0F3B36,stroke-width:1.5px\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mmd-2"><mxCell connectable="0" parent="1" vertex="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;"><mxGeometry x="20" y="20" width="2216.5" height="757.8" as="geometry"/></mxCell></UserObject>
