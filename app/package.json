{
  "name": "invernadero-iot-app",
  "version": "3.4.1",
  "private": true,
  "description": "Aplicación de escritorio del invernadero IoT: maqueta interactiva, conexión USB con el Arduino, historial y control.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --servir",
    "start": "node build.mjs && electron .",
    "instalador": "node build.mjs && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0"
  },
  "main": "electron/main.cjs",
  "author": "Maicol Beltrán, Julián Ortiz, Andrés López, Julián Urquiza y María Callejas",
  "homepage": "https://github.com/maiwxzs/greenhouse-iot-firmware",
  "build": {
    "appId": "co.edu.unillanos.invernadero",
    "productName": "Invernadero IoT",
    "copyright": "Maicol Beltrán, Julián Ortiz, Andrés López, Julián Urquiza y María Callejas",
    "files": [
      "dist/**",
      "electron/**",
      "recursos/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "recursos"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "recursos/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Invernadero IoT",
      "artifactName": "Invernadero-IoT-${version}-Windows.${ext}",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082"
    }
  }
}
